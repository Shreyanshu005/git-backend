generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                       @id @default(uuid())
  name                 String                       @db.VarChar(100)
  mobileNumber         String                       @unique @db.VarChar(15)
  isVerified           Boolean                      @default(false)
  version              Int                          @default(0)
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  email                String?                      @unique @db.VarChar(100)
  isAdmin              Boolean                      @default(false)
  coursePurchases      CoursePurchase[]
  testSeriesPurchases  TestSeriesPurchase[]
  librarySubscriptions DigitalLibrarySubscription[]
  mockTests            MockTest[]

  @@map("users")
}

model Course {
  id              String           @id @default(uuid())
  title           String
  subtitle        String
  image           String
  startDate       String
  features        String[]
  price           Int
  originalPrice   Int
  discount        Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  coursePurchases CoursePurchase[] @relation("CourseToPurchase")
}

model TestSeries {
  id                  String               @id @default(uuid())
  title               String
  subtitle            String
  image               String
  startDate           String
  features            String[]
  price               Int
  originalPrice       Int
  discount            Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  testSeriesPurchases TestSeriesPurchase[] @relation("TestSeriesToPurchase")
}

model TestSeriesPurchase {
  id           String     @id @default(uuid())
  userId       String
  testSeriesId String
  purchasedAt  DateTime   @default(now())
  status       String
  testSeries   TestSeries @relation("TestSeriesToPurchase", fields: [testSeriesId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])
}

model CoursePurchase {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  purchasedAt DateTime @default(now())
  status      String
  course      Course   @relation("CourseToPurchase", fields: [courseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model CurrentAffair {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  pdfUrl    String
  createdAt DateTime @default(now())
}

model DailyPracticeQuestion {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  pdfUrl    String
  createdAt DateTime @default(now())
}

model MockTest {
  id         String             @id @default(uuid())
  subject    String
  difficulty String
  userId     String
  expiresAt  DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  questions  MockTestQuestion[]
  user       User               @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("mock_tests")
}

model MockTestQuestion {
  id             String   @id @default(uuid())
  testId         String
  questionText   String
  options        String[]
  correctAnswer  Int
  questionNumber Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  test           MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@map("mock_test_questions")
}

model EBook {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  description String
  author      String
  category    String
  coverImage  String
  pdfUrl      String
  fileSize    String
  pages       Int
  language    String   @default("English")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ebooks")
}

model DigitalLibrarySubscription {
  id               String    @id @default(uuid())
  userId           String
  subscriptionType String    @default("lifetime")
  amount           Int       @default(499)
  status           String    @default("active")
  purchasedAt      DateTime  @default(now())
  expiresAt        DateTime?
  paymentId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])

  @@map("digital_library_subscriptions")
}
